# ============================================================================
# .env.e2e.example — plantilla para correr Playwright E2E localmente o en CI
#
# Uso:
#   1. cp .env.e2e.example .env.e2e
#   2. Rellenar SÓLO los MÍNIMOS (marcados abajo) para arrancar. Los opcionales
#      pueden quedar vacíos: sus specs se saltan con `test.skip(...)`.
#   3. bun run e2e:check   # valida qué está listo y qué se saltará
#   4. bun run e2e         # corre todos los specs habilitados
#
# NUNCA commitear `.env.e2e`. Está en `.gitignore`.
# NUNCA usar credenciales productivas — provisiona un tenant de staging.
# ============================================================================

# ---------- MÍNIMOS (obligatorios: sin estos Playwright no arranca) ---------

# URL contra la que corren los specs.
#   Local:   http://localhost:8080
#   Staging: https://staging.tuapp.lovable.app
E2E_BASE_URL=http://localhost:8080

# Cuenta interna con acceso completo (rol admin/admin_org en staging).
E2E_EMAIL=admin-staging@librecarga.test
E2E_PASSWORD=changeme

# ---------- PORTAL CLIENTE (habilita specs 05, 18) --------------------------

E2E_PORTAL_EMAIL=cliente-staging@empresa.test
E2E_PORTAL_PASSWORD=changeme

# ---------- CROSS-ORG (spec 06) — IDs de OTRA organización ------------------
# Si faltan, el spec usa UUIDs dummy y sólo valida el guard, no la fuga real.

E2E_CROSS_ORG_EMBARQUE_ID=
E2E_CROSS_ORG_FACTURA_ID=
E2E_CROSS_ORG_COTIZACION_ID=

# ---------- FLAGS QUE HABILITAN SPECS AVANZADOS -----------------------------
# Si vale "1" el spec corre; vacío = skip.

E2E_HAS_SEED=              # 07 wizard teclado (requiere cotización semilla)
E2E_FISCAL=                # 08, 25 (requieren FacturApi sandbox conectado)
E2E_PROFORMA_NUMERO=       # 08 — folio PRO-XXXX de staging
E2E_HAS_AUDIT_DATA=        # 10 auditoría bulk (requiere hallazgos previos)
E2E_ADMIN_ORG=             # 09 — probar bypass admin_org

# ---------- IDs SEMILLA PARA SPECS MUTADORES (09–12) ------------------------
# Estos specs modifican datos reales y hacen cleanup best-effort. Requieren
# datos preexistentes en el tenant de staging.

E2E_EMBARQUE_CHECKLIST_INCOMPLETO_ID=   # 09
E2E_COTIZACION_ACEPTADA_ID=             # 11
E2E_PROVEEDOR_ID=                       # 12
E2E_EMBARQUE_PARA_CXP_ID=               # 12

# ---------- MULTI-TENANT (spec 26) ------------------------------------------
# Dos orgs A/B con datos trazadores. Requiere provisión previa:
#   bun run e2e:provision-multi-tenant

E2E_MT_A_EMAIL=
E2E_MT_A_PASSWORD=
E2E_MT_B_EMAIL=
E2E_MT_B_PASSWORD=

# ---------- PROVISIONING (edge function) ------------------------------------
# Requerido si vas a correr `bun run e2e:provision*`. Debe coincidir con el
# runtime secret `E2E_PROVISION_SECRET` del proyecto Cloud.

E2E_PROVISION_SECRET=
E2E_ORG_ID=                # opcional — si no, se usa la primera org
E2E_CLIENTE_ID=            # opcional — si no, se usa el primer cliente

# Credenciales del proyecto Cloud (Supabase) — sólo necesarias para provisión.
# Se toman de `.env` automático; sólo repítelas aquí si tu shell no las lee.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------- MODO ESTRICTO ---------------------------------------------------
# Si "1", `requireFixture()` promueve skips por fixture ausente a fallo duro.
# Útil en CI dispatch cuando quieres garantía de que TODOS los specs corran.
E2E_STRICT_FIXTURES=

# ---------- TUNING ----------------------------------------------------------
# Sobrescribe workers Playwright (default: 4 local, 2 CI).
E2E_WORKERS=
