    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-day-picker": "^10",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.81.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "recharts": "2.15.4",
    "sonner": "2.0.7",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
