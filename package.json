{
  "name": "libre-carga",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "*.css",
    "*.scss",
    "./src/main.tsx",
    "./src/lib/sentry.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:low-mem": "BUILD_SOURCEMAPS=false vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content",
    "lint:unused": "knip --no-progress",
    "lint:unused:strict": "knip --no-progress --include files,dependencies,unlisted,duplicates,exports,types",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=\"--max-old-space-size=8192\" vitest run",
    "ci:fast": "bash scripts/ci-fast.sh",
    "test:ci": "bun run test:coverage:merge",
    "test:shard": "NODE_OPTIONS=\"--max-old-space-size=8192\" vitest run",
    "test:watch": "vitest",
    "test:fast": "NODE_OPTIONS=\"--max-old-space-size=8192\" vitest run --exclude='**/canaries/**' --exclude='**/pdfLeak*' --exclude='src/**/*.perf.test.tsx' --exclude='src/**/*.perf.ts'",
    "test:perf": "NODE_OPTIONS=\"--max-old-space-size=8192\" vitest run --config vitest.perf.config.ts",
    "test:coverage": "NODE_OPTIONS=\"--max-old-space-size=8192\" vitest run --coverage",
    "test:coverage:shard": "NODE_OPTIONS=\"--max-old-space-size=8192\" vitest run --coverage --reporter=blob --reporter=default --retry=2",
    "test:coverage:merge": "NODE_OPTIONS=\"--max-old-space-size=4096\" vitest run --merge-reports=.vitest-reports --coverage",
    "coverage:report": "tsx scripts/coverage-report.ts",
    "changelog:add": "tsx scripts/add-changelog.ts",
    "changelog:json": "tsx scripts/generate-changelog-json.ts",
    "gen:types": "supabase gen types typescript --db-url \"$DATABASE_URL\" --schema public > src/integrations/supabase/types.ts",
    "audit:casts": "tsx scripts/audit-casts.ts",
    "audit:tests": "tsx scripts/audit-tests.ts",
    "audit:arch": "tsx scripts/audit-architecture.ts",
    "audit:rpc-sync": "tsx scripts/audit-rpc-sync.ts",
    "audit:schema": "tsx scripts/audit-schema-columns.ts",
    "audit:rpc-columns": "tsx scripts/audit-rpc-columns.ts",
    "audit:report": "tsx scripts/audit-report.ts",
    "audit:migrations": "tsx scripts/audit-migrations.ts",
    "audit:schema-functions": "tsx scripts/audit-schema-functions.ts",
    "audit:replay-mirror": "tsx scripts/audit-replay-mirror.ts",
    "audit:manifest": "tsx scripts/audit-release-manifest.ts",
    "audit:no-env": "bun scripts/audit-no-env.ts",
    "audit:sonner": "bun scripts/audit-sonner-baseline.ts",
    "audit:soft-delete": "bun scripts/audit-soft-delete-reads.ts",
    "audit:db-integrity": "psql -v ON_ERROR_STOP=1 -X -q -A -t -f scripts/db/integrity-guard.sql",
    "db:verify": "bash scripts/db/local-verify.sh",
    "db:verify:all": "bash scripts/db/local-verify.sh --all",
    "db:baseline:update": "bash scripts/db/local-verify.sh --only-schema --snapshot supabase/schema/baseline.sql",
    "db:release-manifest:update": "tsx scripts/audit-release-manifest.ts --update",
    "db:baseline:check": "bash scripts/db/local-verify.sh --only-schema --snapshot /tmp/schema.actual.sql && diff -u supabase/schema/baseline.sql /tmp/schema.actual.sql",
    "audit:all": "bun run audit:no-env && bun run audit:arch && bun run audit:casts && bun run audit:tests && bun run audit:rpc-sync && bun run audit:schema && bun run audit:rpc-columns && bun run audit:migrations && bun run audit:schema-functions && bun run audit:replay-mirror && bun run audit:manifest && bun run audit:sonner && bun run audit:soft-delete && bun run audit:report",
    "e2e:provision": "tsx scripts/e2e/provision-users.ts",
    "e2e:check": "tsx scripts/e2e/check-env.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:local": "E2E_BASE_URL=http://localhost:8080 playwright test",
    "e2e:staging": "playwright test",
    "e2e:provision-multi-tenant": "tsx scripts/e2e/provision-multi-tenant.ts",
    "e2e:seed": "tsx scripts/e2e/seed-demo.ts",
    "ci:local": "bun run lint && bun run lint:unused && bun run test && bun run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "3.10.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-pdf/renderer": "4.6.1",
    "@sentry/react": "^10.72.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/query-sync-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "3.14.10",
    "@testing-library/dom": "^10.4.1",
    "@types/papaparse": "^5.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "currency.js": "^2.0.4",
    "date-fns": "3.6.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "libphonenumber-js": "1.13.11",
    "lucide-react": "1.33.0",
    "nuqs": "2.10.0",
    "papaparse": "5.6.0",
    "react": "^19.2.8",
    "react-day-picker": "^10",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.86.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.4",
    "sonner": "2.0.8",
    "tailwind-merge": "^3",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.51.2",
    "use-debounce": "^10.1.1",
    "usehooks-ts": "^3.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@react-pdf/types": "^2.14.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "3.2.4",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "fast-glob": "^3.3.3",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "knip": "^6.33.0",
    "lovable-tagger": "^1.3.3",
    "postcss": "^8.5.26",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.21",
    "vitest": "3.2.4",
    "zod-validation-error": "^4.0.2"
  },
  "overrides": {
    "zod-validation-error": "^4.0.2"
  },
  "resolutions": {
    "zod-validation-error": "^4.0.2"
  }
}
