    "knip": "^6.26.0",
    "lovable-tagger": "^1.3.1",
    "postcss": "^8.5.16",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.10"
  }
}
