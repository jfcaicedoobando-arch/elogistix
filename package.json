{
  "name": "libre-carga",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "24.22.1",
    "bun": "1.4.4"
  },
  "sideEffects": [
    "*.css",
    "*.scss",
    "./src/main.tsx",
    "./src/lib/sentry.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:low-mem": "BUILD_SOURCEMAPS=false vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint . --cache --cache-location .cache/eslint/ --cache-strategy content",
    "lint:unused": "knip --no-progress",
    "lint:unused:strict": "knip --no-progress --include files,dependencies,unlisted,duplicates,exports,types",
    "typecheck": "tsc -b",
    "test:dependencies": "node --test scripts/tests/dependency-security.test.mjs scripts/tests/supabase-sdk-contracts.test.mjs",
    "typecheck:ci": "node scripts/ci/typecheck-incremental.mjs",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=\"--max-old-space-size=8192\" vitest run",
    "ci:fast": "bash scripts/ci-fast.sh",
    "test:ci": "bun run test",
    "test:shard": "NODE_OPTIONS=\"--max-old-space-size=8192\" vitest run",
    "test:watch": "vitest",
    "test:fast": "NODE_OPTIONS=\"--max-old-space-size=8192\" vitest run --exclude='**/canaries/**' --exclude='**/pdfLeak*' --exclude='src/**/*.perf.test.tsx' --exclude='src/**/*.perf.ts'",
    "test:perf": "NODE_OPTIONS=\"--max-old-space-size=8192\" vitest run --config vitest.perf.config.ts",
    "test:pdf": "vitest run --config vitest.pdf.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:coverage": "NODE_OPTIONS=\"--max-old-space-size=8192\" vitest run --coverage",
    "test:coverage:shard": "NODE_OPTIONS=\"--max-old-space-size=8192\" vitest run --coverage --reporter=blob --reporter=default --retry=2",
    "test:coverage:merge": "NODE_OPTIONS=\"--max-old-space-size=4096\" vitest run --merge-reports=.vitest-reports --coverage",
    "coverage:report": "tsx scripts/coverage-report.ts",
    "changelog:add": "tsx scripts/add-changelog.ts",
    "changelog:json": "tsx scripts/generate-changelog-json.ts",
    "gen:types": "supabase gen types typescript --db-url \"$DATABASE_URL\" --schema public > src/integrations/supabase/types.ts",
    "audit:casts": "tsx scripts/audit-casts.ts",
    "audit:tests": "tsx scripts/audit-tests.ts",
    "audit:arch": "tsx scripts/audit-architecture.ts",
    "audit:rpc-sync": "tsx scripts/audit-rpc-sync.ts",
    "audit:schema": "tsx scripts/audit-schema-columns.ts",
    "audit:rpc-columns": "tsx scripts/audit-rpc-columns.ts",
    "audit:report": "tsx scripts/audit-report.ts",
    "audit:migrations": "tsx scripts/audit-migrations.ts",
    "audit:schema-functions": "tsx scripts/audit-schema-functions.ts",
    "audit:replay-mirror": "tsx scripts/audit-replay-mirror.ts",
    "audit:manifest": "tsx scripts/audit-release-manifest.ts",
    "check:published-version": "tsx scripts/check-published-version.ts",
    "audit:no-env": "bun scripts/audit-no-env.ts",
    "audit:sonner": "bun scripts/audit-sonner-baseline.ts",
    "audit:soft-delete": "bun scripts/audit-soft-delete-reads.ts",
    "audit:db-integrity": "psql -v ON_ERROR_STOP=1 -X -q -A -t -f scripts/db/integrity-guard.sql",
    "db:verify": "bash scripts/db/local-verify.sh",
    "db:verify:all": "bash scripts/db/local-verify.sh --all",
    "db:baseline:update": "bash scripts/db/local-verify.sh --only-schema --snapshot supabase/schema/baseline.sql",
    "db:postcheck": "bash scripts/db/postcheck.sh",
    "db:release-manifest:update": "tsx scripts/audit-release-manifest.ts --update",
    "db:baseline:check": "bash scripts/db/local-verify.sh --only-schema --snapshot /tmp/schema.actual.sql && diff -u supabase/schema/baseline.sql /tmp/schema.actual.sql",
    "audit:all": "bun run audit:no-env && bun run audit:arch && bun run audit:casts && bun run audit:tests && bun run audit:rpc-sync && bun run audit:schema && bun run audit:rpc-columns && bun run audit:migrations && bun run audit:schema-functions && bun run audit:replay-mirror && bun run audit:manifest && bun run audit:sonner && bun run audit:soft-delete && bun run audit:report",
    "e2e:provision": "tsx scripts/e2e/provision-users.ts",
    "e2e:check": "tsx scripts/e2e/check-env.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:local": "E2E_BASE_URL=http://localhost:8080 playwright test",
    "e2e:staging": "playwright test",
    "e2e:provision-multi-tenant": "tsx scripts/e2e/provision-multi-tenant.ts",
    "e2e:seed": "tsx scripts/e2e/seed-demo.ts",
    "ci:local": "bun run lint -- --max-warnings=0 && bun run typecheck && bun run lint:unused && bun run test:ci && bun run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "4.9.0",
    "@sentry/core": "11.9.0",
    "@sentry/react": "11.9.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/query-sync-storage-persister": "5.105.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-persist-client": "5.105.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "3.14.23",
    "@testing-library/dom": "^10.4.2",
    "@types/papaparse": "^5.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "currency.js": "^2.0.4",
    "decimal.js": "^10.6.0",
    "date-fns": "4.4.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.61.0",
    "nuqs": "2.10.2",
    "papaparse": "5.7.0",
    "react": "^19.3.1",
    "react-day-picker": "^10",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-router": "8.5.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "^3",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.51.2",
    "use-debounce": "^10.1.1",
    "usehooks-ts": "^3.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@react-pdf/types": "^2.14.0",
    "@sentry/bundler-plugins": "11.9.0",
    "@tanstack/react-query-devtools": "5.105.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "5.0.5",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fast-glob": "^3.3.3",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "lovable-tagger": "^1.3.5",
    "postcss": "^8.5.31",
    "postgres": "^3.4.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
