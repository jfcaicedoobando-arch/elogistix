# Copiar a `.env` (NO commitear). Todos los valores son públicos-en-cliente
# (publishable/anon) y los inyecta Lovable Cloud al conectar el backend.
# Si `.env` falta al publicar, la app compila con `undefined` y truena.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...anon-key-publicable...
VITE_SUPABASE_PROJECT_ID=tu-project-ref

# ── Sentry (observabilidad) ──────────────────────────────────────────────
# DSN público del proyecto Sentry (elogistix/javascript-react). Es seguro
# vivir en bundle. Sin este valor, `initSentry()` no arranca en producción.
VITE_SENTRY_DSN=https://xxxxx@oXXXX.ingest.us.sentry.io/XXXX
# Override manual del `environment` (production | preview | staging | development).
# Si se omite, se infiere del hostname (librecarga.com → production, *.lovable.app → preview).
# VITE_SENTRY_ENV=preview
# Hash corto del build (git SHA) para distinguir hotfixes con el mismo semver.
# Lo inyecta CI; en local puede quedar vacío.
# VITE_BUILD_HASH=
# Sample rates opcionales (0..1). Si se omiten, se usan los defaults del código.
# VITE_SENTRY_PROFILES_SAMPLE_RATE=0.1
# VITE_SENTRY_REPLAYS_ON_ERROR_RATE=1.0
# VITE_SENTRY_REPLAYS_SESSION_RATE=0

# Sentry auth token para subir source maps desde CI (nunca en cliente).
# SENTRY_AUTH_TOKEN=sntrys_...
# DSN alterno usado por edge functions (server-side); si se omite reutilizan VITE_SENTRY_DSN.
# SENTRY_DSN_EDGE=

# Solo tests E2E locales — nunca hardcodear credenciales en `.cjs`.
# E2E_USER_EMAIL=usuario-de-pruebas@ejemplo.com
# E2E_USER_PASSWORD=cambia-esto
