{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.html",
    "scripts/**/*.ts",
    "src/**/*.test.{ts,tsx}",
    "src/**/__tests__/**/*.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts"
  ],
  "ignore": [
    "src/integrations/supabase/types.ts",
    "src/components/ui/**",
    "src/test/**",
    "src/features/*/index.ts",
    "src/features/crm/domain/index.ts",
    "src/components/shared/dialogs/DeleteConfirmDialog.tsx",
    "src/components/shared/dialogs/DocumentPreviewDialog.tsx"
  ],
  "ignoreDependencies": [
    "react-helmet-async"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "duplicates": "error",
    "exports": "warn",
    "types": "warn",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "binaries": "off",
    "unresolved": "off"
  }
}
