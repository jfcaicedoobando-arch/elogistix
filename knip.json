{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "index.html",
        "scripts/**/*.ts",
        "docs/qa/tailwind-integration-20261017/integration.mjs",
        "src/**/*.test.{ts,tsx}",
        "src/**/__tests__/**/*.{ts,tsx}",
        "src/features/*/index.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "scripts/**/*.ts"
      ],
      "node": {
        "entry": [
          "server.js",
          "!supabase/functions/**"
        ]
      },
      "ignoreDependencies": [
        "@sentry/deno",
        "facturapi",
        "@lovable.dev/vite-plugin-dev-server-bridge",
        "@lovable.dev/vite-plugin-hmr-gate"
      ]
    },
    "scripts/ci/selector148": {
      "entry": [
        "concurrency.cjs",
        "run.cjs",
        "static-check.cjs",
        "tests/**/*.test.cjs"
      ],
      "project": [
        "**/*.cjs"
      ]
    }
  },
  "ignore": [
    "src/integrations/supabase/types.ts",
    "src/components/ui/**",
    "src/test/**"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "duplicates": "error",
    "exports": "warn",
    "types": "warn",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "binaries": "off",
    "unresolved": "off"
  }
}
