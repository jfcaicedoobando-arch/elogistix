{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "index.html",
        "scripts/**/*.ts",
        "scripts/db/test-proforma-fixture-lock-order.mjs",
        "src/**/*.test.{ts,tsx}",
        "src/**/__tests__/**/*.{ts,tsx}",
        "src/features/*/index.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.ts"
      ],
      "ignoreDependencies": [
        "drizzle-orm"
      ]
    },
    "scripts/ci/selector148": {
      "entry": [
        "concurrency.cjs",
        "tests/**/*.test.cjs"
      ],
      "project": [
        "**/*.cjs"
      ]
    }
  },
  "ignore": [
    "src/integrations/supabase/types.ts",
    "src/components/ui/**",
    "src/test/**"
  ],
  "ignoreDependencies": [
    "react-helmet-async"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "duplicates": "error",
    "exports": "warn",
    "types": "warn",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "binaries": "off",
    "unresolved": "off"
  }
}
